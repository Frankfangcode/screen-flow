{
  "name": "workshop-danmaku-overlay",
  "productName": "工作坊彈幕",
  "version": "1.0.0",
  "private": true,
  "description": "Transparent click-through danmaku overlay for the projector Mac.",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "dist": "CSC_IDENTITY_AUTO_DISCOVERY=false electron-builder --mac --publish never",
    "dist:dmg": "CSC_IDENTITY_AUTO_DISCOVERY=false electron-builder --mac dmg --universal --publish never",
    "dist:zip": "CSC_IDENTITY_AUTO_DISCOVERY=false electron-builder --mac zip --arm64 --x64 --publish never",
    "icon": "node make-icon.js"
  },
  "devDependencies": {
    "electron": "^45.4.1",
    "electron-builder": "^26.18.0"
  },
  "build": {
    "appId": "tw.edu.workshop.danmaku-overlay",
    "productName": "工作坊彈幕",
    "directories": { "output": "dist" },
    "files": ["main.js", "preload.js", "setup.html", "icon.png", "trayTemplate.png"],
    "mac": {
      "category": "public.app-category.utilities",
      "icon": "icon.png",
      "identity": null,
      "gatekeeperAssess": false,
      "target": [
        { "target": "dmg", "arch": ["universal"] },
        { "target": "zip", "arch": ["arm64", "x64"] }
      ]
    },
    "dmg": { "title": "工作坊彈幕" }
  }
}
