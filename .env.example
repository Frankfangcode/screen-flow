# Required for host controls (pause, clear, slides, filter).
# Use a long random string. Restart the server after changing it.
HOST_PASSWORD=change-me-to-a-long-password

# Shown on the projector and encoded in the QR code. 1–12 letters or digits.
ROOM_CODE=1124

# Public origin for the QR code, no trailing slash.
# Leave empty locally (the server uses the LAN address when you open localhost).
# On Render you can leave this empty; the request host is used.
PUBLIC_URL=

# Render sets PORT. Locally the default is 4721.
PORT=4721
